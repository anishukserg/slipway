#!/bin/sh
# pre-commit по решениям 8 и 14. Инструмент собирается из рабочего дерева, а
# калитку он собирает и запускает из выгруженного дерева коммита.
root=$(git rev-parse --show-toplevel) || exit 2
export CARGO_TARGET_DIR="$root/target/tool" RUSTUP_AUTO_INSTALL=0
exec cargo run --quiet --locked --manifest-path "$root/Cargo.toml" -p slipway-cli -- hook pre-commit
